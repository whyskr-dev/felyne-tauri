{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "Narrow bridge surface granted to the remote felyne.app origin. This is what enables the Tauri IPC on the remote page and limits what it can call.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://felyne.app"]
  },
  "permissions": [
    "core:default",
    "mobile-push:default",
    "allow-shell-platform",
    "allow-shell-version",
    "allow-shell-notify",
    "allow-shell-open-external",
    "allow-shell-notifications-permission",
    "allow-shell-request-notification-permission",
    "allow-shell-check-for-update",
    "allow-shell-install-update"
  ]
}
